#
# User unit: starts the client with the graphical session, so messages arrive
# without anybody opening a terminal.
#
#   systemctl --user daemon-reload
#   systemctl --user enable --now ntfy-desktop.service
#   journalctl --user -u ntfy-desktop -f

[Unit]
Description=ntfy-desktop client
Documentation=https://github.com/maurorosero/ntfy-desktop
PartOf=graphical-session.target
After=graphical-session.target
# A configuration that is broken fails at once, so the unit is restarted a few
# times and then gives up: without this limit the journal fills with the same
# line forever.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/ntfy-desktop --daemon
# SIGTERM ends the process in well under a second; this is only a backstop for
# a dialog or a call that does not let go.
TimeoutStopSec=5
Restart=on-failure
RestartSec=2

# Only what the program needs. The dialog tool talks to the session's display,
# which on X11 lives in /tmp/.X11-unix, so the unit keeps the real /tmp.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
# The leading dash: a fresh account has no such directories yet, and a missing
# path must not keep the unit from starting.
ReadWritePaths=-%h/.config/ntfy-desktop -%h/.local/share/ntfy-desktop

[Install]
WantedBy=graphical-session.target
