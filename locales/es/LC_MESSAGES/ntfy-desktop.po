#: cmd/ntfy-desktop/main.go
msgid "user"
msgstr "usuario"

#: cmd/ntfy-desktop/main.go
msgid "locale"
msgstr "idioma"

#: cmd/ntfy-desktop/main.go
msgid "desktop"
msgstr "escritorio"

#: cmd/ntfy-desktop/main.go
msgid "dialogs"
msgstr "diálogos"

#: cmd/ntfy-desktop/main.go
msgid "no dialog tool found"
msgstr "sin herramienta de diálogo"

#: cmd/ntfy-desktop/main.go
msgid "prints the version and exits"
msgstr "muestra la versión y termina"

#: internal/config/config.go
msgid "must not be empty"
msgstr "no puede estar vacío"

#: internal/config/config.go
msgid "must be an http or https URL"
msgstr "tiene que ser una URL http o https"

#: internal/config/config.go
msgid "must not have a query or a fragment"
msgstr "no puede tener query ni fragmento"

#: internal/config/config.go
msgid "must be 1 to 64 characters of letters, digits, dashes or underscores"
msgstr "tiene que tener de 1 a 64 caracteres: letras, dígitos, guiones o guiones bajos"

#: internal/config/config.go
msgid "%q is not a valid topic: use 1 to 64 characters of letters, digits, dashes or underscores"
msgstr "%q no es un topic válido: usá de 1 a 64 caracteres entre letras, dígitos, guiones o guiones bajos"

#: internal/config/config.go
msgid "must not contain a colon"
msgstr "no puede contener dos puntos"

#: internal/config/config.go
msgid "must not contain control characters"
msgstr "no puede contener caracteres de control"

#: internal/config/config.go
msgid "requires a user name"
msgstr "necesita un nombre de usuario"

#: internal/config/config.go
msgid "requires a password"
msgstr "necesita una contraseña"

#: internal/config/toml.go
msgid "expected key = value"
msgstr "se esperaba clave = valor"

#: internal/config/toml.go
msgid "invalid key"
msgstr "clave inválida"

#: internal/config/toml.go
msgid "value must be a quoted string"
msgstr "el valor tiene que ir entre comillas"

#: internal/config/toml.go
msgid "unexpected text after the closing quote"
msgstr "hay texto inesperado después de cerrar las comillas"

#: internal/config/toml.go
msgid "invalid escape sequence"
msgstr "secuencia de escape inválida"

#: internal/config/toml.go
msgid "unterminated quoted value"
msgstr "valor entre comillas sin cerrar"

#: internal/config/toml.go
msgid "duplicate key"
msgstr "clave repetida"

#: internal/config/toml.go
msgid "unsupported key"
msgstr "clave no soportada"

#: internal/notify/notify.go
msgid "Open"
msgstr "Abrir"

#: internal/dialog/dialog.go
msgid "Decision"
msgstr "Decisión"

#: internal/dialog/dialog.go
msgid "Decision (%d of %d)"
msgstr "Decisión (%d de %d)"

#: internal/dialog/dialog.go
msgid "Dismiss"
msgstr "Descartar"

#: internal/dialog/text.go
msgid "Choose an action"
msgstr "Elegí una acción"

#: internal/dialog/zenity.go
msgid "Select"
msgstr "Elegir"

#: internal/dialog/zenity.go
msgid "Action"
msgstr "Acción"

#: internal/config/config.go
msgid "must be debug, info, warn or error"
msgstr "debe ser debug, info, warn o error"

#: cmd/ntfy-desktop/commands.go
msgid "usage: ntfy-desktop [command] [flags]"
msgstr "uso: ntfy-desktop [comando] [opciones]"

#: cmd/ntfy-desktop/commands.go
msgid "run until stopped: subscribe, notify and ask for decisions"
msgstr "corre hasta que lo detengan: suscribe, avisa y pide decisiones"

#: cmd/ntfy-desktop/commands.go
msgid "log level: debug, info, warn or error (default: info)"
msgstr "nivel de registro: debug, info, warn o error (por omisión: info)"

#: cmd/ntfy-desktop/commands.go
msgid "unexpected argument %q"
msgstr "argumento inesperado %q"

#: cmd/ntfy-desktop/commands.go
msgid "cannot run %q and %q at once"
msgstr "no se pueden pedir %q y %q a la vez"

#: cmd/ntfy-desktop/commands.go
msgid "unknown command %q"
msgstr "comando desconocido %q"

#: cmd/ntfy-desktop/commands.go
msgid "invalid log level %q: use debug, info, warn or error"
msgstr "nivel de registro inválido %q: usá debug, info, warn o error"

#: cmd/ntfy-desktop/publish.go
msgid "usage: ntfy-desktop publish [topic] [flags]"
msgstr "uso: ntfy-desktop publish [tema] [opciones]"

#: cmd/ntfy-desktop/publish.go
msgid "topic to publish to (default: the one in the configuration)"
msgstr "tema al que publicar (por omisión: el de la configuración)"

#: cmd/ntfy-desktop/publish.go
msgid "message title"
msgstr "título del mensaje"

#: cmd/ntfy-desktop/publish.go
msgid "priority from 1 to 5, or min, low, default, high or max"
msgstr "prioridad de 1 a 5, o min, low, default, high o max"

#: cmd/ntfy-desktop/publish.go
msgid "tags, separated by commas"
msgstr "etiquetas, separadas por comas"

#: cmd/ntfy-desktop/publish.go
msgid "url to open when the notification is clicked"
msgstr "URL que se abre al hacer clic en el aviso"

#: cmd/ntfy-desktop/publish.go
msgid "render the message as Markdown"
msgstr "muestra el mensaje como Markdown"

#: cmd/ntfy-desktop/publish.go
msgid "the topic is given both as an argument and with --topic"
msgstr "el tema va como argumento y con --topic a la vez"

#: cmd/ntfy-desktop/publish.go
msgid "invalid priority %q: use 1 to 5, min, low, default, high or max"
msgstr "prioridad inválida %q: usá de 1 a 5, min, low, default, high o max"

#: cmd/ntfy-desktop/publish.go
msgid "the server did not return a message id"
msgstr "el servidor no devolvió un identificador de mensaje"

#: cmd/ntfy-desktop/publish.go
msgid "the configuration names several topics: say which one to publish to as an argument or with --topic"
msgstr "la configuración nombra varios topics: decí a cuál publicar como argumento o con --topic"

#: cmd/ntfy-desktop/publish.go
msgid "reading the message from stdin"
msgstr "leyendo el mensaje de la entrada estándar"

#: cmd/ntfy-desktop/publish.go
msgid "the message is larger than %d bytes"
msgstr "el mensaje supera los %d bytes"

#: cmd/ntfy-desktop/publish.go
msgid "the message body is empty: write it to stdin"
msgstr "el cuerpo del mensaje está vacío: escribilo en la entrada estándar"

#: cmd/ntfy-desktop/publish.go
msgid "the server refused to publish to %s: the topic may be read-only, or the credentials may not be allowed to write to it"
msgstr "el servidor rechazó publicar en %s: puede que el tema sea de sólo lectura o que las credenciales no tengan permiso de escritura"

#: cmd/ntfy-desktop/publish.go
msgid "publishing to %s failed"
msgstr "no se pudo publicar en %s"
#: cmd/ntfy-desktop/commands.go
msgid "lists the messages kept in the local history"
msgstr "lista los mensajes guardados en el historial local"

#: cmd/ntfy-desktop/commands.go
msgid "with history, lists only the messages that have not been read"
msgstr "con history, lista sólo los mensajes que no se leyeron"

#: cmd/ntfy-desktop/commands.go
msgid "--unread only makes sense with history"
msgstr "--unread sólo tiene sentido con history"

#: cmd/ntfy-desktop/history.go
msgid "the history is empty"
msgstr "el historial está vacío"

#: cmd/ntfy-desktop/history.go
msgid "no unread messages"
msgstr "no hay mensajes sin leer"

#: cmd/ntfy-desktop/history.go
msgid "(no title)"
msgstr "(sin título)"

#: internal/config/document.go
msgid "cannot remove the only topic"
msgstr "no se puede quitar el único topic"

#: internal/config/document.go
msgid "%q is already in the topic list"
msgstr "%q ya está en la lista de topics"

#: internal/config/document.go
msgid "%q is not in the topic list"
msgstr "%q no está en la lista de topics"

#: internal/config/document.go
msgid "expected a quoted value on this line"
msgstr "falta el valor entre comillas en esta línea"

#: cmd/ntfy-desktop/config.go
msgid "       ntfy-desktop config topic --add name | --remove name"
msgstr "       ntfy-desktop config topic --add nombre | --remove nombre"

#: cmd/ntfy-desktop/config.go
msgid "show the effective configuration and the path of the file"
msgstr "muestra la configuración efectiva y la ruta del archivo"

#: cmd/ntfy-desktop/config.go
msgid "verify the file, the server, the credentials and every topic, and write nothing"
msgstr "verifica el archivo, el servidor, las credenciales y cada topic, sin escribir nada"

#: cmd/ntfy-desktop/config.go
msgid "change one key: server, topic, user or log-level"
msgstr "cambia una clave: server, topic, user o log-level"

#: cmd/ntfy-desktop/config.go
msgid "read the password from the standard input instead of asking for it without echo"
msgstr "lee la contraseña de la entrada estándar en vez de preguntarla sin eco"

#: cmd/ntfy-desktop/config.go
msgid "--set expects key=value"
msgstr "--set espera clave=valor"

#: cmd/ntfy-desktop/config.go
msgid "the password is never given as an argument: use --password-stdin"
msgstr "la contraseña no va nunca como argumento: usá --password-stdin"

#: cmd/ntfy-desktop/config.go
msgid "--set does not know the key %q: use server, topic, user or log-level"
msgstr "--set no conoce la clave %q: usá server, topic, user o log-level"

#: cmd/ntfy-desktop/config.go
msgid "--password-stdin goes with --set, or alone to change only the password"
msgstr "--password-stdin va con --set, o solo para cambiar únicamente la contraseña"

#: cmd/ntfy-desktop/config.go
msgid "usage: ntfy-desktop config topic --add name | --remove name"
msgstr "uso: ntfy-desktop config topic --add nombre | --remove nombre"

#: cmd/ntfy-desktop/config.go
msgid "add a topic to the list"
msgstr "agrega un topic a la lista"

#: cmd/ntfy-desktop/config.go
msgid "remove a topic from the list"
msgstr "quita un topic de la lista"

#: cmd/ntfy-desktop/config.go
msgid "config topic takes exactly one of --add or --remove"
msgstr "config topic acepta exactamente una de --add o --remove"

#: cmd/ntfy-desktop/config.go
msgid "--add needs a topic name"
msgstr "--add necesita un nombre de topic"

#: cmd/ntfy-desktop/config.go
msgid "--remove needs a topic name"
msgstr "--remove necesita un nombre de topic"

#: cmd/ntfy-desktop/config.go
msgid "there is no configuration at %s: run ntfy-desktop config to create one"
msgstr "no hay configuración en %s: corré ntfy-desktop config para crear una"

#: cmd/ntfy-desktop/config.go
msgid "the configuration at %s cannot be read: %s"
msgstr "no se puede leer la configuración en %s: %s"

#: cmd/ntfy-desktop/config.go
msgid "path"
msgstr "ruta"

#: cmd/ntfy-desktop/config.go
msgid "server"
msgstr "servidor"

#: cmd/ntfy-desktop/config.go
msgid "topic"
msgstr "topic"

#: cmd/ntfy-desktop/config.go
msgid "password"
msgstr "contraseña"

#: cmd/ntfy-desktop/config.go
msgid "credentials"
msgstr "credenciales"

#: cmd/ntfy-desktop/config.go
msgid "none: the subscription is anonymous"
msgstr "ninguna: la suscripción es anónima"

#: cmd/ntfy-desktop/config.go
msgid "info (default)"
msgstr "info (por defecto)"

#: cmd/ntfy-desktop/config.go
msgid "log level"
msgstr "nivel de log"

#: cmd/ntfy-desktop/config.go
msgid "%s answers as an ntfy server"
msgstr "%s responde como servidor ntfy"

#: cmd/ntfy-desktop/config.go
msgid "the server asks for no credentials: it answered as %s"
msgstr "el servidor no pide credenciales: respondió como %s"

#: cmd/ntfy-desktop/config.go
msgid "%s, role %s"
msgstr "%s, rol %s"

#: cmd/ntfy-desktop/config.go
msgid "the stream of %s opened"
msgstr "se abrió el stream de %s"

#: cmd/ntfy-desktop/config.go
msgid "the configuration file cannot be read or is not valid"
msgstr "el archivo de configuración no se puede leer o no es válido"

#: cmd/ntfy-desktop/config.go
msgid "the server does not answer, or it is not an ntfy server"
msgstr "el servidor no responde, o no es un servidor ntfy"

#: cmd/ntfy-desktop/config.go
msgid "the server rejected the credentials"
msgstr "el servidor rechazó las credenciales"

#: cmd/ntfy-desktop/config.go
msgid "the credentials have no permission for a topic"
msgstr "las credenciales no tienen permiso para un topic"

#: cmd/ntfy-desktop/config.go
msgid "the change was refused: %s"
msgstr "se rechazó el cambio: %s"

#: cmd/ntfy-desktop/config.go
msgid "reading the password from the standard input failed: %s"
msgstr "no se pudo leer la contraseña de la entrada estándar: %s"

#: cmd/ntfy-desktop/config.go
msgid "the configuration at %s cannot be edited: %s"
msgstr "no se puede editar la configuración en %s: %s"

#: cmd/ntfy-desktop/config.go
msgid "the change would leave the configuration invalid: %s"
msgstr "el cambio dejaría la configuración inválida: %s"

#: cmd/ntfy-desktop/config.go
msgid "warning: %v"
msgstr "atención: %v"

#: cmd/ntfy-desktop/config.go
msgid "the configuration could not be written: %s"
msgstr "no se pudo escribir la configuración: %s"

#: cmd/ntfy-desktop/config.go
msgid "wrote %s"
msgstr "escribí %s"

#: cmd/ntfy-desktop/config.go
msgid "the previous version is in %s"
msgstr "la versión anterior está en %s"

#: cmd/ntfy-desktop/config.go
msgid "line %d: %s"
msgstr "línea %d: %s"

#: cmd/ntfy-desktop/config.go
msgid "line %d: %s %q"
msgstr "línea %d: %s %q"

#: cmd/ntfy-desktop/config.go
msgid "line %d: %s: %s"
msgstr "línea %d: %s: %s"

#: cmd/ntfy-desktop/wizard.go
msgid "nothing was written"
msgstr "no se escribió nada"

#: cmd/ntfy-desktop/wizard.go
msgid "the configuration would not be valid: %s"
msgstr "la configuración no quedaría válida: %s"

#: cmd/ntfy-desktop/wizard.go
msgid "warning: some checks could not be verified; the configuration can still be saved"
msgstr "atención: algunas comprobaciones no se pudieron verificar; la configuración se puede guardar igual"

#: cmd/ntfy-desktop/wizard.go
msgid "this is what will be written to %s:"
msgstr "esto es lo que se va a escribir en %s:"

#: cmd/ntfy-desktop/wizard.go
msgid "write the configuration?"
msgstr "¿escribo la configuración?"

#: cmd/ntfy-desktop/wizard.go
msgid "server URL (http or https, with no query and no fragment):"
msgstr "URL del servidor (http o https, sin query ni fragmento):"

#: cmd/ntfy-desktop/wizard.go
msgid "that URL cannot be used: %s"
msgstr "esa URL no se puede usar: %s"

#: cmd/ntfy-desktop/wizard.go
msgid "the server URL was left invalid"
msgstr "la URL del servidor quedó inválida"

#: cmd/ntfy-desktop/wizard.go
msgid "%s does not look like an ntfy server: %v"
msgstr "%s no parece un servidor ntfy: %v"

#: cmd/ntfy-desktop/wizard.go
msgid "%s is not an ntfy server"
msgstr "%s no es un servidor ntfy"

#: cmd/ntfy-desktop/wizard.go
msgid "does the server use a user name and password?"
msgstr "¿el servidor usa usuario y contraseña?"

#: cmd/ntfy-desktop/wizard.go
msgid "user name:"
msgstr "nombre de usuario:"

#: cmd/ntfy-desktop/wizard.go
msgid "password (it is not shown):"
msgstr "contraseña (no se muestra):"

#: cmd/ntfy-desktop/wizard.go
msgid "the user name and the password are both required"
msgstr "el nombre de usuario y la contraseña son obligatorios"

#: cmd/ntfy-desktop/wizard.go
msgid "the credentials were left incomplete"
msgstr "las credenciales quedaron incompletas"

#: cmd/ntfy-desktop/wizard.go
msgid "the server refused the credentials: %v"
msgstr "el servidor rechazó las credenciales: %v"

#: cmd/ntfy-desktop/wizard.go
msgid "the credentials were refused"
msgstr "se rechazaron las credenciales"

#: cmd/ntfy-desktop/wizard.go
msgid "topics, separated by commas:"
msgstr "topics, separados por comas:"

#: cmd/ntfy-desktop/wizard.go
msgid "those topics cannot be used: %s"
msgstr "esos topics no se pueden usar: %s"

#: cmd/ntfy-desktop/wizard.go
msgid "the topics were left invalid"
msgstr "los topics quedaron inválidos"

#: cmd/ntfy-desktop/wizard.go
msgid "%s cannot be read: %v"
msgstr "no se puede leer %s: %v"

#: cmd/ntfy-desktop/prompt.go
msgid "warning: the terminal echo could not be turned off, so the password will be visible: %v"
msgstr "atención: no se pudo apagar el eco del terminal, así que la contraseña va a quedar a la vista: %v"

#: cmd/ntfy-desktop/prompt.go
msgid "warning: the terminal echo could not be turned back on: %v"
msgstr "atención: no se pudo volver a encender el eco del terminal: %v"

#: cmd/ntfy-desktop/prompt.go
msgid "y/n"
msgstr "s/n"

#: cmd/ntfy-desktop/prompt.go
msgid "Y/n"
msgstr "S/n"

#: cmd/ntfy-desktop/prompt.go
msgid "answer yes or no"
msgstr "respondé sí o no"

#: cmd/ntfy-desktop/prompt.go
msgid "reading the answer"
msgstr "leyendo la respuesta"

#: cmd/ntfy-desktop/config.go
msgid "ok"
msgstr "ok"

#: cmd/ntfy-desktop/config.go
msgid "unverified"
msgstr "sin verificar"

#: cmd/ntfy-desktop/config.go
msgid "failed"
msgstr "falla"

#: cmd/ntfy-desktop/config.go
msgid "read"
msgstr "lectura"

#: internal/dialog/prompt.go
msgid "Configure ntfy-desktop"
msgstr "Configurar ntfy-desktop"

#: internal/dialog/prompt.go
msgid "Configure ntfy-desktop — %d of %d · %s"
msgstr "Configurar ntfy-desktop — %d de %d · %s"

#: internal/dialog/prompt.go
msgid "Configure ntfy-desktop — %s"
msgstr "Configurar ntfy-desktop — %s"

#: internal/dialog/prompt.go
msgid "topic %s"
msgstr "topic %s"

#: internal/dialog/prompt.go
msgid "unknown"
msgstr "desconocido"

#: internal/dialog/prompt.go
msgid "a check that could not be verified does not block: the configuration can be saved, and the summary warns about it"
msgstr "un control que quedó sin verificar no bloquea: se puede guardar, y el resumen lo advierte"

#: internal/dialog/kdialog_prompt.go
msgid "Continue"
msgstr "Continuar"

#: internal/dialog/kdialog_prompt.go
msgid "Cancel"
msgstr "Cancelar"

#: internal/dialog/kdialog_prompt.go
msgid "Write"
msgstr "Escribir"

#: internal/dialog/zenity_prompt.go
msgid "Yes"
msgstr "Sí"

#: internal/dialog/zenity_prompt.go
msgid "No"
msgstr "No"

#: internal/dialog/zenity_prompt.go
msgid "Topic"
msgstr "Topic"

#: internal/dialog/kdialog_prompt.go
msgid "topics to subscribe to"
msgstr "topics a los que suscribirse"

#: internal/dialog/kdialog_prompt.go
msgid "add a topic (leave it empty to finish)"
msgstr "agregá un topic (dejalo vacío para terminar)"

#: cmd/ntfy-desktop/config.go
msgid "ask with desktop dialogs, one step per dialog: kdialog on Plasma, zenity as a fallback, the text wizard when there is neither"
msgstr "preguntar con diálogos del escritorio, un paso por diálogo: kdialog en Plasma, zenity como respaldo, el asistente de texto cuando no hay ninguno"

#: cmd/ntfy-desktop/config.go
msgid "config takes one of --gui, --show, --check or --set"
msgstr "config acepta una de --gui, --show, --check o --set"

#: cmd/ntfy-desktop/config.go
msgid "usage: ntfy-desktop config [--gui | --show | --check | --set key=value] [--password-stdin]"
msgstr "uso: ntfy-desktop config [--gui | --show | --check | --set clave=valor] [--password-stdin]"

#: cmd/ntfy-desktop/config.go
msgid "no kdialog or zenity in the PATH: the interview continues in text mode"
msgstr "no hay kdialog ni zenity en el PATH: la entrevista sigue en modo texto"

#: cmd/ntfy-desktop/config.go
msgid "there is no desktop session: the interview continues in text mode"
msgstr "no hay sesión de escritorio: la entrevista sigue en modo texto"

#: cmd/ntfy-desktop/config.go
msgid "%s is not a dialog tool this program knows: the interview continues in text mode"
msgstr "%s no es una herramienta de diálogo que este programa conozca: la entrevista sigue en modo texto"

#: cmd/ntfy-desktop/config.go
msgid "the list needs at least one topic"
msgstr "la lista necesita al menos un topic"

#: cmd/ntfy-desktop/wizard.go
msgid "Server"
msgstr "Servidor"

#: cmd/ntfy-desktop/wizard.go
msgid "Credentials"
msgstr "Credenciales"

#: cmd/ntfy-desktop/wizard.go
msgid "Topics"
msgstr "Topics"

#: cmd/ntfy-desktop/wizard.go
msgid "Verification"
msgstr "Verificar"

#: cmd/ntfy-desktop/wizard.go
msgid "Summary"
msgstr "Resumen y escribir"

#: cmd/ntfy-desktop/wizard.go
msgid "it is written with 0600 permissions; the previous version, if any, is kept as a .bak next to it"
msgstr "se escribe con permisos 0600; la versión anterior, si existe, queda como .bak al lado"
